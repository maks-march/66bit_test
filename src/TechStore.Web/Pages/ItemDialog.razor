@inject TechStoreApi Api
@inject ToastService Toasts
@implements IDisposable

@* Создание/редактирование позиции: фото, справочники, страна с автокомплитом, цена.
   Серверные ошибки валидации раскладываются по полям через ValidationMessageStore. *@
<ModalShell Title="@(Editing is null ? "Добавить технику" : "Редактировать технику")"
            DialogClass="modal-lg" OnClose="OnCancel">
    <ChildContent>
        @if (Types.Count == 0 || Manufacturers.Count == 0)
        {
            <div class="alert alert-warning">Не удалось загрузить справочники — закройте окно и попробуйте позже.</div>
        }
        @if (_formError is not null)
        {
            <div class="alert alert-danger">@_formError</div>
        }
        <EditForm EditContext="_editContext" OnSubmit="HandleSubmitAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Фотография</label>
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    @if (_newPhoto is not null)
                    {
                        <span class="badge text-bg-light border p-2">
                            @_newPhoto.Name · @(_newPhoto.Size / 1024) КБ
                        </span>
                        <button type="button" class="btn btn-link btn-sm px-0" @onclick="() => _newPhoto = null">
                            Выбрать другое
                        </button>
                    }
                    else if (_existingPhotoUrl is not null && !_deletePhoto)
                    {
                        <img src="@_existingPhotoUrl" alt="Фото позиции" class="dlg-photo" />
                        <button type="button" class="btn btn-link btn-sm px-0 text-danger" @onclick="() => _deletePhoto = true">
                            Удалить фото
                        </button>
                    }
                    else
                    {
                        @if (_deletePhoto)
                        {
                            <span class="text-muted small">Фото будет удалено</span>
                            <button type="button" class="btn btn-link btn-sm px-0" @onclick="() => _deletePhoto = false">
                                Вернуть
                            </button>
                        }
                        <div>
                            <label class="btn btn-outline-secondary mb-1">
                                Загрузить фото
                                <InputFile class="d-none" OnChange="OnPhotoSelected" accept=".jpg,.jpeg,.png,.webp" />
                            </label>
                            <div class="form-text">JPG, PNG или WebP · до 5 МБ</div>
                        </div>
                    }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label required">Тип</label>
                    <InputSelect @bind-Value="_model.EquipmentTypeId" class="form-select">
                        <option value="">— Выберите —</option>
                        @foreach (var t in Types)
                        {
                            <option value="@t.Id">@t.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.EquipmentTypeId" />
                </div>
                <div class="col-md-6">
                    <label class="form-label required">Производитель</label>
                    <InputSelect @bind-Value="_model.ManufacturerId" class="form-select">
                        <option value="">— Выберите —</option>
                        @foreach (var m in Manufacturers)
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _model.ManufacturerId" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label required">Модель</label>
                <InputText @bind-Value="_model.Model" class="form-control" placeholder="Например, MacBook Air 13 M3" />
                <ValidationMessage For="() => _model.Model" />
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label required">Страна</label>
                    @* Обычный input: нужен живой oninput для автокомплита
                       (тройная связка bind-Value:event:after не компилируется). *@
                    <input class="form-control @FieldCss(nameof(ItemFormModel.SupplyCountryName))" list="country-list"
                           placeholder="Начните вводить…" autocomplete="off"
                           value="@_model.SupplyCountryName" @oninput="OnCountryInput" />
                    <datalist id="country-list">
                        @foreach (var c in _suggestions)
                        {
                            <option value="@c.Name"></option>
                        }
                    </datalist>
                    <ValidationMessage For="() => _model.SupplyCountryName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label required">Цена, ₽</label>
                    <InputNumber @bind-Value="_model.Price" class="form-control" placeholder="Введите цену" />
                    <ValidationMessage For="() => _model.Price" />
                </div>
            </div>

            <div class="alert alert-light mt-3 mb-0">Тип и производителя можно добавить в разделе «Справочники».</div>
            <p class="text-muted small mt-2 mb-0">* Обязательные поля</p>
        </EditForm>
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="OnCancel">Отмена</button>
        <button type="button" class="btn btn-primary" disabled="@(_busy || Types.Count == 0 || Manufacturers.Count == 0)"
                @onclick="() => HandleSubmitAsync(_editContext)">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
            }
            @(Editing is null ? "Добавить" : "Сохранить")
        </button>
    </FooterContent>
</ModalShell>

@code {
    private const long MaxPhotoBytes = 5 * 1024 * 1024;
    private static readonly string[] AllowedPhotoExtensions = [".jpg", ".jpeg", ".png", ".webp"];

    [Parameter] public EquipmentItemModel? Editing { get; set; }
    [Parameter] public IReadOnlyList<EquipmentTypeModel> Types { get; set; } = [];
    [Parameter] public IReadOnlyList<ManufacturerModel> Manufacturers { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private ItemFormModel _model = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _messages = default!;
    private string? _existingPhotoUrl;
    private IBrowserFile? _newPhoto;
    private bool _deletePhoto;
    private bool _busy;
    private string? _formError;
    private List<SupplyCountryModel> _suggestions = new();
    private CancellationTokenSource? _countryCts;

    protected override void OnInitialized()
    {
        _model = Editing is null ? new ItemFormModel() : ItemFormModel.From(Editing);
        _editContext = new EditContext(_model);
        _messages = new ValidationMessageStore(_editContext);
        _existingPhotoUrl = Api.ResolvePhotoUrl(Editing?.PhotoUrl);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadCountrySuggestionsAsync(null, CancellationToken.None);
    }

    public void Dispose()
    {
        _countryCts?.Cancel();
        _countryCts?.Dispose();
    }

    private void OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;
        if (file.Size > MaxPhotoBytes)
        {
            Toasts.Error("Файл больше 5 МБ — выберите файл поменьше.", "Ошибка загрузки фото");
            return;
        }
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!AllowedPhotoExtensions.Contains(ext))
        {
            Toasts.Error("Нужен JPG, PNG или WebP.", "Ошибка загрузки фото");
            return;
        }
        _newPhoto = file;
        _deletePhoto = false;
    }

    private async Task OnCountryInput(ChangeEventArgs e)
    {
        _model.SupplyCountryName = e.Value?.ToString();
        _countryCts?.Cancel();
        _countryCts?.Dispose();
        var cts = _countryCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await LoadCountrySuggestionsAsync(_model.SupplyCountryName, cts.Token);
    }

    /// <summary>Красная рамка для обычного input — как у Input* при серверной ошибке поля.</summary>
    private string FieldCss(string fieldName)
        => _editContext.GetValidationMessages(_editContext.Field(fieldName)).Any() ? "invalid" : "";

    private async Task LoadCountrySuggestionsAsync(string? search, CancellationToken ct)
    {
        try
        {
            _suggestions = (await Api.AutocompleteCountriesAsync(search, ct)).ToList();
        }
        catch (Exception)
        {
            // Молча: автокомплит — подсказка, страна вводится свободным текстом (upsert на сервере).
        }
    }

    /// <summary>
    /// Единая точка сабмита: Enter в форме и кнопка в футере.
    /// Сначала DataAnnotations, затем ручная проверка цены прямым сравнением decimal
    /// (без строкового парсинга — он ломается в ru-RU).
    /// </summary>
    private async Task HandleSubmitAsync(EditContext context)
    {
        _messages.Clear();
        var valid = context.Validate();
        if (_model.Price is not null)
        {
            if (_model.Price <= 0)
            {
                _messages.Add(context.Field(nameof(ItemFormModel.Price)), "Цена должна быть больше 0.");
                valid = false;
            }
            else if (_model.Price > 999999999.99m)
            {
                _messages.Add(context.Field(nameof(ItemFormModel.Price)), "Цена не должна превышать 999 999 999,99.");
                valid = false;
            }
        }
        if (!valid)
        {
            context.NotifyValidationStateChanged();
            return;
        }
        await SaveAsync();
    }

    private async Task SaveAsync()
    {
        if (_busy)
            return;
        _busy = true;
        _formError = null;
        _messages.Clear();
        _editContext.NotifyValidationStateChanged();

        try
        {
            EquipmentItemModel saved;
            if (Editing is null)
                saved = await Api.CreateItemAsync(_model.ToRequest(), CancellationToken.None);
            else
                saved = await Api.UpdateItemAsync(Editing.Id, _model.ToRequest(), CancellationToken.None);

            if (_newPhoto is not null)
            {
                try
                {
                    await using var stream = _newPhoto.OpenReadStream(MaxPhotoBytes + 1024 * 1024);
                    await Api.SetPhotoAsync(saved.Id, stream, _newPhoto.Name,
                        string.IsNullOrEmpty(_newPhoto.ContentType) ? "image/jpeg" : _newPhoto.ContentType,
                        CancellationToken.None);
                }
                catch (ApiException ex)
                {
                    Toasts.Error(ex.Message, "Позиция сохранена, но фото не загружено");
                }
            }
            else if (_deletePhoto && Editing is not null)
            {
                await Api.ClearPhotoAsync(saved.Id, CancellationToken.None);
            }

            Toasts.Success(Editing is null ? "Позиция добавлена" : "Изменения сохранены");
            await OnSaved.InvokeAsync();
        }
        catch (ApiException ex) when (ex.FieldErrors is not null)
        {
            ApplyServerErrors(ex.FieldErrors);
        }
        catch (ApiException ex)
        {
            _formError = ex.Message;
        }
        catch (Exception)
        {
            _formError = "Сервис временно недоступен. Попробуйте ещё раз.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Серверные имена полей совпадают со свойствами ItemFormModel — маппим 1:1.</summary>
    private void ApplyServerErrors(Dictionary<string, string[]> fields)
    {
        var known = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            nameof(ItemFormModel.EquipmentTypeId),
            nameof(ItemFormModel.ManufacturerId),
            nameof(ItemFormModel.Model),
            nameof(ItemFormModel.SupplyCountryName),
            nameof(ItemFormModel.Price),
        };

        foreach (var (field, messages) in fields)
        {
            var prop = known.FirstOrDefault(k => k.Equals(field, StringComparison.OrdinalIgnoreCase));
            if (prop is null)
            {
                _formError = string.Join(" ", messages);
                continue;
            }
            foreach (var message in messages)
                _messages.Add(_editContext.Field(prop), message);
        }
        _editContext.NotifyValidationStateChanged();
    }
}
