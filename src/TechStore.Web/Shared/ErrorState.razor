@* Ошибка загрузки: иконка, текст, кнопка повтора. *@
<div class="text-center py-5">
    <div class="empty-icon text-danger mb-3">
        <Icon Name="alert" Size="48" />
    </div>
    <h5>@Title</h5>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="text-muted mb-3">@Message</p>
    }
    <button type="button" class="btn btn-outline-primary" @onclick="OnRetry">@RetryText</button>
</div>

@code {
    [Parameter] public string Title { get; set; } = "Не удалось загрузить данные";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string RetryText { get; set; } = "Повторить";
    [Parameter] public EventCallback OnRetry { get; set; }
}
